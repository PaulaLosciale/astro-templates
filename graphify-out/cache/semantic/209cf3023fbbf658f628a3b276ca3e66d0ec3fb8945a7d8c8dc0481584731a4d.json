{"nodes": [{"id": "docs_plan_plan_v2", "label": "Astro Lego Builder v2 Plan", "file_type": "document", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L1-L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business goal: create client websites in minutes, not days; after generation only content/logo personalization remains before billing. All 6 redesign phases executed and verified end-to-end as of 5 July 2026."}, {"id": "docs_plan_receta_v2", "label": "Receta v2", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-page recipe schema (src/data/recipeSchema.ts): types plus presets for themes, palettes, fonts and page templates; the reproducible JSON contract that flows from wizard to API to orchestrator and is saved into each generated project as site.recipe.json."}, {"id": "docs_plan_component_registry", "label": "Component Registry", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/data/componentRegistry.ts maps ~100 real components across 9 themes with per-theme fallbacks so any theme can render any section category."}, {"id": "docs_plan_component_map", "label": "Component Module Map", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/data/componentMap.ts uses import.meta.glob to resolve component variants at render time for the preview."}, {"id": "docs_plan_sitebuilder_wizard", "label": "SiteBuilder Wizard", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/components/automation/SiteBuilder.tsx: 10-step wizard with live preview, saved recipes, validation, and the 'Montar web' trigger."}, {"id": "docs_plan_preview_ssr", "label": "Preview SSR", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/pages/preview.astro server-renders the real component library with the recipe passed via query param, shown as an iframe inside the builder (uses @astrojs/node adapter)."}, {"id": "docs_plan_api_jobs", "label": "Build Jobs API", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/pages/api/build.ts: POST launches the build in background (spawns the orchestrator), GET returns progress; per-job logs stored in .builder-jobs/<job>/log.jsonl."}, {"id": "docs_plan_orquestador_build_site", "label": "Orquestador build-site", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "scripts/build-site.mjs: generates the project, runs npm install, initializes git, creates the GitHub repo and wires Dokploy (app + domain + deploy). Legacy v1 scripts live in scripts/legacy/."}, {"id": "docs_plan_colors_utils", "label": "Color Utils (hex \u2192 HSL scale)", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/utils/colors.ts converts hex to HSL and expands it into a Tailwind 50-700 scale so a single picked color becomes a full palette."}, {"id": "docs_plan_lovable_prompt_generator", "label": "Lovable Prompt Generator", "file_type": "code", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/utils/lovablePrompt.ts generates the Lovable prompt from the current recipe; exposed as a button in the wizard's final step."}, {"id": "docs_plan_component_library", "label": "Component Library (9 themes \u00d7 11 categories)", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L38-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~100 real components in 9 themes (modern, minimalist, creative, corporate, saas, cleantech, elegante, glass, terminal) across 11 section categories; ~440-468 empty AI-generated numbered files were deleted during cleanup. Only ~1/3 of components accept props yet \u2014 parametrizing heroes/CTAs is the top pending priority."}, {"id": "docs_plan_css_variables_theming", "label": "CSS Variables HSL Theming", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Theming via HSL CSS variables (--color-primary-500\u2026) mapped in Tailwind to primary-*/secondary-*/accent-* so the builder palette converts automatically into a full scale applied live to the preview and baked into generated projects."}], "edges": [{"source": "docs_plan_plan_v2", "target": "docs_business_ideas_productized_packages", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L71", "weight": 1.0}, {"source": "docs_plan_sitebuilder_wizard", "target": "docs_plan_api_jobs", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLAN.md", "source_location": "docs/PLAN.md#L14", "weight": 1.0}, {"source": "docs_plan_api_jobs", "target": "docs_plan_orquestador_build_site", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PLAN.m