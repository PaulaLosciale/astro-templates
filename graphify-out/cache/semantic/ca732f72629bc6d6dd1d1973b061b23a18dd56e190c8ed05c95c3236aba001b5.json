{"nodes": [{"id": "docs_guia_paso_a_paso", "label": "Guia completa desde 0", "file_type": "document", "source_file": "docs/GUIA_PASO_A_PASO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guia unica de referencia: la primera vez tarda ~1 hora por cuentas y tokens; a partir de la segunda web, minutos."}, {"id": "docs_guia_paso_a_paso_token_github", "label": "Token de GitHub (fine-grained)", "file_type": "concept", "source_file": "docs/GUIA_PASO_A_PASO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fine-grained token con permisos Administration (crear repos) y Contents (push) sobre todos los repositorios; debe exportarse en la MISMA terminal que arranca el builder porque Montar web hereda ese entorno."}, {"id": "docs_guia_paso_a_paso_api_key_dokploy", "label": "API key de Dokploy", "file_type": "concept", "source_file": "docs/GUIA_PASO_A_PASO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guia_paso_a_paso_environment_id", "label": "Environment ID de Dokploy", "file_type": "concept", "source_file": "docs/GUIA_PASO_A_PASO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guia_paso_a_paso_github_provider_id", "label": "GitHub Provider ID de Dokploy", "file_type": "concept", "source_file": "docs/GUIA_PASO_A_PASO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Necesario para el auto-deploy por push: Dokploy debe estar conectado a GitHub via su GitHub App con acceso a los repos usados; si falta, el push no redespliega."}, {"id": "docs_guia_paso_a_paso_cloudflare_dns", "label": "Cloudflare DNS", "file_type": "concept", "source_file": "docs/GUIA_PASO_A_PASO.md", "source_location": null, "source_url": null, "captu