---
interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: Array<{
    quote: string;
    author: string;
    role: string;
    avatar?: string;
    rating?: number;
  }>;
}

const {
  title = "Lo que dicen nuestros clientes",
  subtitle = "Testimonios de éxito",
  testimonials = [
    {
      quote: "Esta plataforma ha cambiado por completo nuestra forma de trabajar. La eficiencia se ha disparado un 40% en solo tres meses.",
      author: "Sarah Jenkins",
      role: "CEO en TechFlow",
      avatar: "https://i.pravatar.cc/150?u=sarah",
      rating: 5
    },
    {
      quote: "La atención al cliente es excepcional y los componentes son increíblemente fáciles de usar. Justo lo que necesitábamos.",
      author: "Marcos Rodríguez",
      role: "Director de Producto en Innova",
      avatar: "https://i.pravatar.cc/150?u=marcos",
      rating: 5
    },
    {
      quote: "Nunca había sido tan fácil montar una landing de alta calidad. Los templates estilo Lego son una genialidad.",
      author: "Elena García",
      role: "Fundadora de CreativeLabs",
      avatar: "https://i.pravatar.cc/150?u=elena",
      rating: 4
    }
  ]
} = Astro.props;
---

<section class="py-24 bg-gray-50">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-4">
        {subtitle}
      </h2>
      <h3 class="text-4xl lg:text-5xl font-black text-gray-900 mb-6">
        {title}
      </h3>
      <p class="text-xl text-gray-600">
        Únete a miles de profesionales que ya están transformando sus negocios con nuestras soluciones innovadoras.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((t, index) => (
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-shadow duration-300 flex flex-col justify-between">
          <div>
            <!-- Rating -->
            <div class="flex gap-1 mb-6 text-yellow-400">
              {Array.from({ length: t.rating || 5 }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
              ))}
            </div>
            
            <blockquote class="text-lg text-gray-700 leading-relaxed italic mb-8">
              "{t.quote}"
            </blockquote>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-blue-100">
              <img src={t.avatar} alt={t.author} class="w-full h-full object-cover" />
            </div>
            <div>
              <p class="font-bold text-gray-900">{t.author}</p>
              <p class="text-sm text-gray-500">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
