---
export interface Props {
  testimonials?: Array<{
    quote: string;
    author: string;
    role: string;
  }>;
}

const {
  testimonials = [
    {
      quote: "La simplicidad de estos componentes ha reducido nuestro tiempo de desarrollo a la mitad.",
      author: "Elena Martínez",
      role: "CTO en TechFlow"
    },
    {
      quote: "Diseño excepcionalmente limpio. Exactamente lo que buscábamos para nuestra marca.",
      author: "Marcos Ruiz",
      role: "Diseñador Senior"
    }
  ]
} = Astro.props;
---

<section class="py-24 bg-white border-y border-gray-100">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-20">
      {testimonials.map((t) => (
        <div class="flex flex-col">
           <svg class="w-12 h-12 text-gray-200 mb-8" fill="currentColor" viewBox="0 0 32 32"><path d="M10 8v8H6v4h4v4H2v-8h4v-4H2V8h8zm12 0v8h-4v4h4v4h-8v-8h4v-4h-4V8h8z"/></svg>
           <blockquote class="text-3xl font-medium text-gray-900 mb-10 leading-snug">
              "{t.quote}"
           </blockquote>
           <div class="mt-auto">
              <p class="font-bold text-gray-900">{t.author}</p>
              <p class="text-gray-500">{t.role}</p>
           </div>
        </div>
      ))}
    </div>
  </div>
</section>
