---
const { siteName = "Minimal" } = Astro.props;
---
<footer class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-4xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8 mb-16">
      <p class="text-gray-400 dark:text-gray-500 font-medium">© 2026 — {siteName}</p>
      <div class="flex gap-8 text-sm font-bold text-gray-900 dark:text-white">
        <a href="#" class="hover:text-primary-500 transition-colors">LinkedIn</a>
        <a href="#" class="hover:text-primary-500 transition-colors">Twitter</a>
        <a href="#" class="hover:text-primary-500 transition-colors">Mail</a>
      </div>
    </div>
    <div class="w-full h-px bg-gray-100 dark:bg-gray-900"></div>
  </div>
</footer>
