---
const { siteName = "SaaSFlow" } = Astro.props;
---
<footer class="bg-white dark:bg-gray-950 py-16 border-t border-gray-100 dark:border-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 mb-16">
      <div class="max-w-xs">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 bg-primary-500 rounded-lg"></div>
          <span class="text-xl font-bold dark:text-white">{siteName}</span>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm">
          Optimiza tu flujo de trabajo con la plataforma SaaS de próxima generación.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-12">
        <div>
          <h4 class="font-bold mb-6 dark:text-white">Plataforma</h4>
          <ul class="space-y-3 text-sm text-gray-500 dark:text-gray-400">
             <li><a href="#" class="hover:text-primary-500">Log In</a></li>
             <li><a href="#" class="hover:text-primary-500">Sign Up</a></li>
             <li><a href="#" class="hover:text-primary-500">API</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-6 dark:text-white">Empresa</h4>
          <ul class="space-y-3 text-sm text-gray-500 dark:text-gray-400">
             <li><a href="#" class="hover:text-primary-500">Sobre nosotros</a></li>
             <li><a href="#" class="hover:text-primary-500">Careers</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="pt-8 border-t border-gray-100 dark:border-gray-900 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400">© 2026 {siteName}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="text-gray-400 hover:text-primary-500 transition-colors">Privacy</a>
        <a href="#" class="text-gray-400 hover:text-primary-500 transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
