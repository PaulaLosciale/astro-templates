<section class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
     <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        <div class="p-12 bg-gray-50 dark:bg-gray-900 rounded-[3rem] border border-gray-100 dark:border-gray-800 transition-all hover:border-primary-500">
           <h3 class="text-3xl font-black mb-2 dark:text-white text-primary-500">Básico</h3>
           <p class="text-gray-500 dark:text-gray-400 mb-8 font-medium">Perfecto para proyectos personales.</p>
           <div class="text-6xl font-black mb-12 dark:text-white italic tracking-tighter">$15</div>
           <button class="w-full py-5 border-2 border-gray-900 dark:border-white rounded-full font-black text-xs uppercase tracking-widest hover:bg-gray-900 dark:hover:bg-white hover:text-white dark:hover:text-black transition-all">Empieza Gratis</button>
        </div>
        <div class="p-12 bg-gray-900 dark:bg-primary-600 rounded-[3rem] text-white shadow-2xl relative overflow-hidden">
           <div class="absolute top-0 right-0 p-8 text-primary-500 dark:text-white/20 text-8xl font-black leading-none pointer-events-none select-none italic">PRO</div>
           <h3 class="text-3xl font-black mb-2 text-primary-500 dark:text-white">Pro</h3>
           <p class="text-white/60 mb-8 font-medium italic">Acceso total para profesionales.</p>
           <div class="text-6xl font-black mb-12 italic tracking-tighter">$49</div>
           <button class="w-full py-5 bg-primary-500 dark:bg-white dark:text-primary-600 rounded-full font-black text-xs uppercase tracking-widest hover:scale-105 transition-all">Consigue Pro</button>
        </div>
     </div>
  </div>
</section>
