---
---
<section class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20">
       <h2 class="text-4xl font-black text-gray-900 dark:text-white mb-6">Planes para cada <span class="text-primary-500 underline underline-offset-8">etapa</span></h2>
       <p class="text-gray-500 dark:text-gray-400">Escala tu equipo sin complicaciones con precios transparentes.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
       {/* Basic */}
       <div class="p-10 rounded-[2.5rem] bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 transition-all hover:scale-105">
          <h3 class="text-xl font-bold mb-4 dark:text-white">Starter</h3>
          <p class="text-4xl font-bold mb-8 dark:text-white">$0 <span class="text-sm font-medium text-gray-400">/mes</span></p>
          <ul class="space-y-4 mb-10 text-gray-500 dark:text-gray-400 text-sm">
             <li>✓ 3 proyectos activos</li>
             <li>✓ Soporte por comunidad</li>
             <li>✓ Exportación básica</li>
          </ul>
          <button class="w-full py-4 bg-gray-200 dark:bg-gray-800 rounded-2xl font-bold dark:text-white hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">Elegir Plan</button>
       </div>

       {/* Pro */}
       <div class="p-10 rounded-[2.5rem] bg-gray-900 dark:bg-primary-600 text-white shadow-2xl shadow-primary-500/30 scale-110 relative z-10">
          <span class="absolute top-0 right-10 -translate-y-1/2 bg-primary-500 dark:bg-white text-white dark:text-primary-600 px-4 py-1 rounded-full text-xs font-black uppercase tracking-widest">Popular</span>
          <h3 class="text-xl font-bold mb-4">Professional</h3>
          <p class="text-4xl font-bold mb-8">$29 <span class="text-sm font-medium opacity-60">/mes</span></p>
          <ul class="space-y-4 mb-10 text-white/80 text-sm font-medium">
             <li>✓ Proyectos ilimitados</li>
             <li>✓ Soporte prioritario 24/7</li>
             <li>✓ Analíticas avanzadas</li>
             <li>✓ Integraciones Pro</li>
          </ul>
          <button class="w-full py-4 bg-primary-500 dark:bg-white dark:text-primary-600 rounded-2xl font-black hover:bg-primary-600 dark:hover:bg-gray-100 transition-colors">Empezar Pro</button>
       </div>

       {/* Enterprise */}
       <div class="p-10 rounded-[2.5rem] bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 transition-all hover:scale-105">
          <h3 class="text-xl font-bold mb-4 dark:text-white">Enterprise</h3>
          <p class="text-4xl font-bold mb-8 dark:text-white">Custom</p>
          <ul class="space-y-4 mb-10 text-gray-500 dark:text-gray-400 text-sm">
             <li>✓ Seguridad a medida</li>
             <li>✓ SLA garantizado</li>
             <li>✓ Manager dedicado</li>
          </ul>
          <button class="w-full py-4 bg-gray-200 dark:bg-gray-800 rounded-2xl font-bold dark:text-white hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors">Contactar</button>
       </div>
    </div>
  </div>
</section>
