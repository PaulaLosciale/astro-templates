---
<section class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-4xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-20">
       <div>
         <h2 class="text-2xl font-bold dark:text-white mb-6 uppercase tracking-widest text-primary-500 underline underline-offset-8">Atributos</h2>
         <p class="text-gray-400 dark:text-gray-500 text-sm leading-relaxed">Definimos el éxito a través de la coherencia y el silencio visual.</p>
       </div>
       <div class="space-y-12">
          {['Claridad', 'Velocidad', 'Precisión'].map(title => (
            <div>
              <h3 class="text-xl font-bold dark:text-white mb-2">{title}</h3>
              <p class="text-gray-400 dark:text-gray-500 text-sm italic">Eliminamos lo innecesario para potenciar lo esencial.</p>
            </div>
          ))}
       </div>
    </div>
  </div>
</section>
