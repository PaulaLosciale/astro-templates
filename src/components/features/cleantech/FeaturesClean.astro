<section class="py-32 bg-gray-50 dark:bg-gray-950 transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
       {[1,2,3,4,5,6].map(i => (
          <div class="text-center p-12 bg-white dark:bg-black rounded-[2.5rem] border border-gray-100 dark:border-gray-900 transition-all hover:shadow-xl group">
             <div class="mb-10 text-4xl group-hover:scale-110 transition-transform">⚡️</div>
             <h3 class="text-2xl font-bold dark:text-white mb-4 tracking-tight">Rendimiento {i}x</h3>
             <p class="text-gray-500 dark:text-gray-400 font-light leading-relaxed">Arquitectura optimizada al nanómetro para una eficiencia sin precedentes.</p>
          </div>
       ))}
    </div>
  </div>
</section>
