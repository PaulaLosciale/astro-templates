---
export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  features?: Array<{
    icon: string;
    title: string;
    description: string;
    color?: string;
  }>;
}

const {
  title = "Características poderosas",
  subtitle = "Todo lo que necesitas",
  description = "Descubre las herramientas y funcionalidades que harán que tu proyecto destaque entre la multitud.",
  features = [
    {
      icon: "rocket",
      title: "Súper Rápido",
      description: "Carga en milisegundos con nuestra optimización avanzada y CDN global.",
      color: "blue"
    },
    {
      icon: "shield",
      title: "Totalmente Seguro",
      description: "Protección de nivel empresarial con encriptación end-to-end.",
      color: "green"
    },
    {
      icon: "code",
      title: "Fácil Integración",
      description: "API RESTful y SDKs para todos los lenguajes populares.",
      color: "purple"
    },
    {
      icon: "users",
      title: "Colaboración",
      description: "Trabaja en equipo con herramientas de colaboración en tiempo real.",
      color: "orange"
    },
    {
      icon: "chart",
      title: "Analytics Avanzado",
      description: "Obtén insights profundos con nuestro sistema de análisis integrado.",
      color: "pink"
    },
    {
      icon: "support",
      title: "Soporte 24/7",
      description: "Nuestro equipo está disponible cuando lo necesites, en cualquier momento.",
      color: "indigo"
    }
  ]
} = Astro.props;

const getIcon = (iconName: string) => {
  const icons = {
    rocket: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>`,
    shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>`,
    code: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>`,
    users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a4 4 0 11-8 0 4 4 0 018 0z"></path>`,
    chart: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>`,
    support: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>`
  };
  return icons[iconName as keyof typeof icons] || icons.rocket;
};
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-semibold text-blue-600 uppercase tracking-wide mb-4">
        {subtitle}
      </h2>
      <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        {title}
      </h3>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        {description}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature, index) => {
        // Definir clases de color dinámicamente
        let colorClasses = "";
        switch(feature.color) {
          case "blue":
            colorClasses = "bg-blue-100 text-blue-600 group-hover:bg-blue-200";
            break;
          case "green":
            colorClasses = "bg-green-100 text-green-600 group-hover:bg-green-200";
            break;
          case "purple":
            colorClasses = "bg-purple-100 text-purple-600 group-hover:bg-purple-200";
            break;
          case "orange":
            colorClasses = "bg-orange-100 text-orange-600 group-hover:bg-orange-200";
            break;
          case "pink":
            colorClasses = "bg-pink-100 text-pink-600 group-hover:bg-pink-200";
            break;
          case "indigo":
            colorClasses = "bg-indigo-100 text-indigo-600 group-hover:bg-indigo-200";
            break;
          default:
            colorClasses = "bg-blue-100 text-blue-600 group-hover:bg-blue-200";
        }

        return (
          <div class="group relative bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-xl hover:border-gray-200 transition-all duration-300 hover:-translate-y-1">
            <!-- Icon -->
            <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl mb-6 transition-colors duration-300 ${colorClasses}`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={getIcon(feature.icon)} />
              </svg>
            </div>

            <!-- Content -->
            <h4 class="text-xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors">
              {feature.title}
            </h4>
            <p class="text-gray-600 leading-relaxed">
              {feature.description}
            </p>

            <!-- Hover Effect Background -->
            <div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-purple-50 rounded-2xl opacity-0 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"></div>
          </div>
        );
      })}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <p class="text-gray-600 mb-6">
        ¿Listo para empezar con todas estas características?
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/empezar"
          class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
        >
          Comenzar ahora
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a 
          href="/demo"
          class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-base font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
        >
          Ver demo en vivo
        </a>
      </div>
    </div>
  </div>
</section>