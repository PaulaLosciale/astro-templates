---
---
<section class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20 max-w-2xl mx-auto">
       <h2 class="text-4xl font-black text-gray-900 dark:text-white mb-6">Herramientas <span class="text-primary-500 underline decoration-primary-500/20 underline-offset-8">Premium</span></h2>
       <p class="text-gray-500 dark:text-gray-400 text-lg">Todo lo que necesitas para escalar tu presencia digital con elegancia.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {[1,2,3].map(i => (
        <div class="group">
           <div class="mb-8 relative overflow-hidden rounded-[2rem]">
              <div class="absolute inset-0 bg-primary-500 opacity-0 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity"></div>
              <div class="w-20 h-20 bg-gray-50 dark:bg-gray-900 rounded-3xl flex items-center justify-center text-primary-500 text-3xl font-bold group-hover:shadow-2xl transition-all">✧</div>
           </div>
           <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Módulo {i}</h3>
           <p class="text-gray-500 dark:text-gray-400 leading-relaxed font-medium">Integración perfecta con el ecosistema moderno de Astro y React.</p>
        </div>
      ))}
    </div>
  </div>
</section>
