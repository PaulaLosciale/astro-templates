---
const features = [
  {
    version: "V1.0.4",
    title: "Low Latency Edge",
    description: "0x29A: Optimized packet routing for global clusters. Distributed computing at light speed.",
    status: "STABLE",
    statusColor: "text-[#64748B]"
  },
  {
    version: "V2.1.0",
    title: "Quantum Encryption",
    description: "End-to-end security via distributed shared secrets. Invisible, unbreakable, sovereign.",
    status: "ONLINE",
    statusColor: "text-[#00D084]"
  },
  {
    version: "V0.9.8",
    title: "Neural Mesh",
    description: "Adaptive network topology that learns and evolves. Self-healing node clusters.",
    status: "SYNCING",
    statusColor: "text-[#FFB800]"
  }
];
---
<section class="w-full py-24 px-6 md:px-12 bg-[#0A0F1C]">
  <div class="max-w-7xl mx-auto">
    
    <div class="flex items-center justify-between mb-16 border-b border-[#1E293B] pb-8">
      <div class="flex flex-col gap-2">
        <span class="text-[#00D084] font-mono text-xs uppercase tracking-[0.2em] font-bold">
          [ CORE_CAPAbilities ]
        </span>
        <h2 class="text-white font-mono text-3xl md:text-4xl font-bold uppercase">
          System Features
        </h2>
      </div>
      <div class="hidden md:block text-[#64748B] font-mono text-[10px] text-right uppercase tracking-widest">
        // ROOT_DIRECTORY<br/>
        // FEAT_EXPLORER_V1
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="group relative bg-[#1E293B] rounded-sm p-8 border border-transparent hover:border-[#00D084]/30 transition-all duration-300">
          <!-- Card Header Decorator -->
          <div class="absolute top-0 right-0 p-4 opacity-20">
            <span class="text-[#00D084] font-mono text-[10px] uppercase">
              // 0x{Math.floor(Math.random() * 1000).toString(16).toUpperCase()}
            </span>
          </div>

          <div class="flex flex-col gap-6">
            <div class="flex items-center justify-between">
              <span class="bg-[#0A0F1C] px-3 py-1 rounded-full text-[#64748B] font-mono text-[10px] font-bold">
                {feature.version}
              </span>
              <span class={`${feature.statusColor} font-mono text-[10px] font-bold tracking-widest uppercase`}>
                {feature.status}
              </span>
            </div>

            <div class="flex flex-col gap-4">
              <h3 class="text-white font-mono text-xl font-bold hover:text-[#00D084] transition-all duration-300">
                {feature.title}
              </h3>
              <p class="text-[#64748B] font-inter text-sm leading-relaxed">
                {feature.description}
              </p>
            </div>

            <div class="mt-4 pt-6 border-t border-[#0A0F1C]/50 flex items-center justify-between">
              <a href="#" class="text-white font-mono text-[10px] uppercase tracking-widest hover:text-[#00D084] transition-all flex items-center gap-2">
                [ READ_LOGS ]
                <span class="text-[#00D084]">_</span>
              </a>
              <div class="h-1 w-8 bg-[#0A0F1C]"></div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
