---
---
<section class="py-32 bg-gray-900 text-white overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
    <div>
      <h4 class="text-primary-500 font-bold uppercase tracking-widest text-xs mb-8">Nuestras Capacidades</h4>
      <h2 class="text-5xl font-serif font-bold mb-12 leading-tight">Infraestructura global para empresas <span class="italic font-light">sin fronteras</span>.</h2>
      <div class="space-y-12">
        <div class="flex gap-8 border-l border-primary-500 pl-8">
           <div class="flex-1">
             <h3 class="text-xl font-bold mb-2">Resiliencia Operativa</h3>
             <p class="text-gray-400 font-light">Garantizamos un uptime del 99.99% en todas nuestras regiones.</p>
           </div>
        </div>
        <div class="flex gap-8 border-l border-gray-800 pl-8 hover:border-primary-500 transition-all">
           <div class="flex-1">
             <h3 class="text-xl font-bold mb-2">Cumplimiento Normativo</h3>
             <p class="text-gray-400 font-light">Certificaciones SOC2, GDPR y HIPAA integradas nativamente.</p>
           </div>
        </div>
      </div>
    </div>
    
    <div class="relative">
       <div class="bg-primary-600/10 w-full aspect-square rounded-full absolute -top-20 -right-20 blur-3xl opacity-20"></div>
       <div class="grid grid-cols-2 gap-4">
          <div class="h-64 bg-gray-800 border border-gray-700"></div>
          <div class="h-64 bg-primary-600 border border-primary-500 mt-12"></div>
       </div>
    </div>
  </div>
</section>
