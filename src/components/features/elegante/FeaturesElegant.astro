---
const f1 = "/images/generated-1773937059933.png";
const f2 = "/images/generated-1773937092772.png";
---
<section class="p-[100px] bg-[#FAF9F6] dark:bg-zinc-900 transition-colors duration-700">
    <div class="flex gap-10 w-full mb-20 animate-fade-in">
        <div class="flex-1 group overflow-hidden bg-white dark:bg-black cursor-pointer">
            <img src={f1} alt="Product 1" class="w-full h-[600px] object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000" />
            <div class="p-6">
                <p class="text-[10px] font-bold tracking-widest uppercase text-gray-500">Accesorios</p>
                <h3 class="mt-2 text-sm font-light text-black dark:text-white uppercase tracking-tighter">Bolso Editorial Limited</h3>
            </div>
        </div>
        <div class="flex-1 group overflow-hidden bg-white dark:bg-black cursor-pointer">
            <img src={f2} alt="Product 2" class="w-full h-[600px] object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000" />
            <div class="p-6">
                <p class="text-[10px] font-bold tracking-widest uppercase text-gray-500">Calzado</p>
                <h3 class="mt-2 text-sm font-light text-black dark:text-white uppercase tracking-tighter">Zapatos de Piel Hechos a Mano</h3>
            </div>
        </div>
    </div>
</section>
