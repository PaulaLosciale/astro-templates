---
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  features?: Array<{
    title: string;
    description: string;
    icon: string;
    color?: string;
  }>;
}

const {
  title = "Potencia tu Flujo de Trabajo",
  subtitle = "Características de Elite",
  description = "No solo construimos herramientas, creamos ventajas competitivas. Descubre la tecnología que redefine el estándar de la industria.",
  features = [
    {
      title: "Automatización IA",
      description: "Nuestros algoritmos aprenden de tus procesos para optimizarlos automáticamente.",
      icon: "cpu",
      color: "blue"
    },
    {
      title: "Escalabilidad Infinita",
      description: "Infraestructura cloud que crece contigo, sin latencia ni tiempos de inactividad.",
      icon: "cloud",
      color: "purple"
    },
    {
      title: "Seguridad Cuántica",
      description: "Cifrado de próxima generación para proteger tus datos contra cualquier amenaza futura.",
      icon: "shield",
      color: "green"
    },
    {
      title: "Panel de Analytics",
      description: "Visualiza el pulso de tu negocio con métricas detalladas en tiempo real.",
      icon: "bar-chart",
      color: "orange"
    }
  ]
} = Astro.props;

const getIcon = (icon: string) => {
  const icons = {
    cpu: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>`,
    cloud: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>`,
    shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>`,
    'bar-chart': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>`
  };
  return icons[icon as keyof typeof icons] || icons.cpu;
};
---

<section class="py-24 bg-white relative overflow-hidden">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 40px 40px;"></div>

  <div class="container mx-auto px-6 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="max-w-3xl mb-20">
      <h2 class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-4">
        {subtitle}
      </h2>
      <h3 class="text-4xl lg:text-6xl font-black text-gray-900 mb-8 tracking-tight">
        {title}
      </h3>
      <p class="text-xl text-gray-600 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Features Bento-ish Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {features.map((feature, index) => (
        <div 
          class="group p-8 rounded-[2rem] bg-gray-50 border border-gray-100 hover:bg-white hover:shadow-2xl hover:shadow-blue-900/10 hover:-translate-y-2 transition-all duration-500 cursor-default"
        >
          <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-8 transition-colors duration-500 bg-white shadow-sm group-hover:bg-blue-600 group-hover:text-white`}>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <Fragment set:html={getIcon(feature.icon)} />
            </svg>
          </div>
          
          <h4 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors">
            {feature.title}
          </h4>
          <p class="text-gray-600 leading-relaxed group-hover:text-gray-700">
            {feature.description}
          </p>
          
          <div class="mt-8 pt-8 border-t border-gray-200/50 flex justify-between items-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            <span class="text-blue-600 font-bold text-sm">Explorar más</span>
            <svg class="w-5 h-5 text-blue-600 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Decorative Callout -->
    <div class="mt-20 p-1 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-3xl shadow-xl">
      <div class="bg-white rounded-[1.4rem] p-10 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="flex items-center gap-6">
          <div class="w-16 h-16 bg-blue-50 rounded-full flex items-center justify-center">
             <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div>
            <h5 class="text-2xl font-bold text-gray-900">¿Listo para ver más?</h5>
            <p class="text-gray-500">Nuestra galería completa tiene más de 50 componentes listos para usar.</p>
          </div>
        </div>
        <a href="/components" class="px-10 py-4 bg-gray-900 text-white rounded-xl font-bold hover:bg-gray-800 transition shadow-lg">
          Ver Documentación
        </a>
      </div>
    </div>
  </div>
</section>
