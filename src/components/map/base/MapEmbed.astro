---
const {
  title = "Dónde estamos",
  description = "",
  mapEmbed = "",
  address = "",
} = Astro.props;
---
<section class="py-24 bg-gray-50 dark:bg-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <span class="text-primary-500 font-bold uppercase tracking-widest text-sm">Ubicación</span>
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mt-3 mb-4">{title}</h2>
    {(description || address) && <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mb-10">{description || address}</p>}
    <div class="rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 shadow-sm">
      {mapEmbed ? (
        <iframe
          src={mapEmbed}
          title="Mapa de ubicación"
          width="100%"
          height="440"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      ) : (
        <div class="h-[440px] flex flex-col items-center justify-center gap-3 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">
          <span class="text-4xl">📍</span>
          <p class="font-medium">Mapa pendiente de configurar</p>
          <p class="text-sm max-w-md text-center">Añade la URL de embed de Google Maps en el paso Extras del builder (Compartir → Insertar un mapa → copiar el src del iframe).</p>
        </div>
      )}
    </div>
  </div>
</section>
