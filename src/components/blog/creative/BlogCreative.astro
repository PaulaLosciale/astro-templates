<section class="py-32 bg-black text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-7xl md:text-9xl font-black italic tracking-tighter leading-none mb-24 opacity-10">JOURNAL.</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-1 py-1 bg-white/10">
       {[1,2,3,4].map(i => (
         <div class="p-16 bg-black group hover:bg-primary-500 transition-all duration-700 cursor-pointer">
            <span class="text-primary-500 group-hover:text-black font-black text-xs uppercase tracking-[0.4em] mb-12 block">Issue 0{i}</span>
            <h3 class="text-4xl font-black italic tracking-tight group-hover:text-black transition-colors uppercase leading-none">Manifesto for the New Creative Age —</h3>
            <p class="mt-8 text-white/40 group-hover:text-black/60 font-medium italic transition-colors">A vision of simplicity in high technology.</p>
         </div>
       ))}
    </div>
  </div>
</section>
