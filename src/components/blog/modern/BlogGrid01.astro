---
interface Props {
  title?: string;
  subtitle?: string;
  posts?: Array<{
    title: string;
    excerpt: string;
    category: string;
    author: string;
    date: string;
    image: string;
    href: string;
  }>;
}

const {
  title = "Historias y Perspectivas",
  subtitle = "Nuestro Blog",
  posts = [
    {
      title: "El futuro del diseño web en 2026",
      excerpt: "Descubre las tendencias que están redefiniendo cómo interactuamos con el mundo digital.",
      category: "Diseño",
      author: "Alex Rivera",
      date: "15 Mar, 2026",
      image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=2672",
      href: "/blog/futuro-diseno"
    },
    {
      title: "Optimizando Astro para el máximo rendimiento",
      excerpt: "Guía paso a paso para lograr una puntuación de 100 en Lighthouse con Astro 5.",
      category: "Desarrollo",
      author: "Marina Soler",
      date: "10 Mar, 2026",
      image: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=2670",
      href: "/blog/optimizar-astro"
    },
    {
      title: "Cómo escalar tu startup sin morir en el intento",
      excerpt: "Lecciones aprendidas tras ayudar a más de 500 empresas a crecer digitalmente.",
      category: "Negocios",
      author: "Julio Castro",
      date: "05 Mar, 2026",
      image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=2426",
      href: "/blog/escalar-startup"
    }
  ]
} = Astro.props;
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="max-w-2xl">
        <h2 class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-4">
          {subtitle}
        </h2>
        <h3 class="text-4xl lg:text-5xl font-black text-gray-900 mb-6">
          {title}
        </h3>
        <p class="text-xl text-gray-600">
          Explora nuestros últimos artículos, guías y noticias sobre tecnología y diseño.
        </p>
      </div>
      <a href="/blog" class="px-8 py-4 border-2 border-gray-100 rounded-xl font-bold hover:border-blue-600 hover:text-blue-600 transition-all">
        Ver todos los posts
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {posts.map((post) => (
        <article class="group h-full flex flex-col bg-white rounded-3xl overflow-hidden border border-gray-100 hover:shadow-2xl hover:shadow-blue-900/10 transition-all duration-500">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img 
              src={post.image} 
              alt={post.title} 
              class="w-full h-full object-cover transition duration-700 group-hover:scale-110"
            />
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 bg-white/90 backdrop-blur-md rounded-lg text-xs font-bold text-gray-900 uppercase tracking-wider">
                {post.category}
              </span>
            </div>
          </div>
          
          <div class="p-8 flex flex-col flex-grow">
            <div class="flex items-center gap-3 mb-4 text-xs font-medium text-gray-500">
              <time>{post.date}</time>
              <span>•</span>
              <span>{post.author}</span>
            </div>
            
            <h4 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-blue-600 transition-colors line-clamp-2">
              <a href={post.href}>{post.title}</a>
            </h4>
            
            <p class="text-gray-600 mb-8 line-clamp-3">
              {post.excerpt}
            </p>
            
            <div class="mt-auto pt-6 border-t border-gray-50">
              <a href={post.href} class="inline-flex items-center gap-2 text-blue-600 font-bold hover:gap-3 transition-all">
                Leer más
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
