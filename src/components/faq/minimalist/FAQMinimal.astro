---
<section class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-2xl mx-auto px-6 space-y-16">
     {['Soporte', 'Pagos', 'Licencia'].map(cat => (
        <div>
           <h3 class="text-xs font-black uppercase tracking-[0.4em] text-primary-500 mb-8">{cat}</h3>
           <details class="group py-6 border-t border-gray-100 dark:border-gray-900 cursor-pointer">
              <summary class="font-bold dark:text-white list-none">Información detallada sobre {cat.toLowerCase()}</summary>
              <p class="mt-4 text-gray-400 dark:text-gray-500 text-sm leading-relaxed px-4">Proceso simplificado y automatizado para garantizar la mejor experiencia de usuario posible.</p>
           </details>
        </div>
     ))}
  </div>
</section>
