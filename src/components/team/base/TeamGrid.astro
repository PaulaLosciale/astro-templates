---
const {
  title = "Nuestro equipo",
  description = "Las personas detrás del proyecto.",
} = Astro.props;
const members = [
  { name: "Nombre Apellido", role: "Fundador/a", initials: "NA" },
  { name: "Nombre Apellido", role: "Dirección", initials: "NA" },
  { name: "Nombre Apellido", role: "Atención al cliente", initials: "NA" },
  { name: "Nombre Apellido", role: "Especialista", initials: "NA" },
];
---
<section class="py-24 bg-gray-50 dark:bg-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <span class="text-primary-500 font-bold uppercase tracking-widest text-sm">Equipo</span>
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mt-3 mb-4">{title}</h2>
    <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mb-12">{description}</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {members.map((member) => (
        <article class="bg-white dark:bg-gray-950 rounded-2xl p-8 text-center shadow-sm hover:shadow-lg transition-shadow">
          <div class="w-24 h-24 mx-auto rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-5">
            <span class="text-2xl font-black text-primary-600">{member.initials}</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">{member.name}</h3>
          <p class="text-primary-500 font-medium text-sm mt-1">{member.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>
