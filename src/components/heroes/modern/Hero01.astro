---
export interface Props {
  heroImage?: string;
}

const {
  heroImage = "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=2426"
} = Astro.props;
---
<section class="relative py-32 bg-cover bg-center text-center overflow-hidden" style={`background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url(${heroImage})`}>
  <div class="container mx-auto px-4 relative z-10 text-white leading-relaxed">
    <h2 class="text-4xl font-bold mb-4">Bienvenido a mi página</h2>
    <p class="text-lg text-gray-600 mb-8">
      Aquí puedes poner un texto llamativo para captar la atención.
    </p>
    <a href="#"
       class="bg-blue-500 hover:bg-blue-600 text-white font-semibold px-6 py-3 rounded-lg">
       Empezar ahora
    </a>
  </div>
</section>
