---
const {
  title = "Elegancia hecha a medida",
  description = "Diseño artesanal y atención al detalle en cada pieza.",
  siteName = "Atelier",
} = Astro.props;
const heroImg = "/images/generated-1773937806591.png";
---
<section class="min-h-[92vh] grid grid-cols-1 lg:grid-cols-2 bg-zinc-50 dark:bg-zinc-950 transition-colors">
  <div class="flex flex-col justify-center px-8 lg:px-20 py-24 order-2 lg:order-1">
    <span class="uppercase tracking-[0.3em] text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-8">{siteName}</span>
    <h1 class="font-serif text-5xl lg:text-7xl leading-[1.05] text-zinc-900 dark:text-zinc-50 mb-8">{title}</h1>
    <p class="text-lg text-zinc-600 dark:text-zinc-300 max-w-md mb-10">{description}</p>
    <div class="flex items-center gap-8">
      <a href="#contacto" class="border border-zinc-900 dark:border-zinc-100 text-zinc-900 dark:text-zinc-100 px-10 py-4 uppercase tracking-widest text-xs font-semibold hover:bg-zinc-900 hover:text-white dark:hover:bg-zinc-100 dark:hover:text-zinc-900 transition-colors">Descubrir</a>
      <div class="w-16 h-px bg-zinc-300 dark:bg-zinc-700"></div>
    </div>
  </div>
  <div class="relative min-h-[40vh] order-1 lg:order-2 overflow-hidden">
    <img src={heroImg} alt="" class="absolute inset-0 w-full h-full object-cover" />
  </div>
</section>
