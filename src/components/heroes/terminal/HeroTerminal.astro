---
---
<section class="w-full min-h-[800px] flex flex-col justify-center items-center py-20 px-6 bg-[#0A0F1C] relative overflow-hidden">
  <!-- Scanline / Grid Effect -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(0deg, transparent 24%, #00D084 25%, #00D084 26%, transparent 27%, transparent 74%, #00D084 75%, #00D084 76%, transparent 77%, transparent), linear-gradient(90deg, transparent 24%, #00D084 25%, #00D084 26%, transparent 27%, transparent 74%, #00D084 75%, #00D084 76%, transparent 77%, transparent); background-size: 80px 80px;"></div>

  <div class="max-w-4xl w-full flex flex-col items-center gap-6 relative z-10 transition-all duration-700 animate-in fade-in slide-in-from-bottom-8">
    
    <div class="flex items-center gap-3 mb-4">
      <span class="text-[#00D084] font-mono text-sm font-bold tracking-[0.2em] animate-pulse">
        [ SYSTEM_INITIALizing... ]
      </span>
      <div class="h-[1px] w-20 bg-[#1E293B]"></div>
    </div>

    <h1 class="text-white font-mono text-5xl md:text-8xl font-bold text-center leading-[0.9] uppercase tracking-tighter">
      DECENTRAlizED<br/>
      <span class="text-transparent" style="-webkit-text-stroke: 1px rgba(255,255,255,0.3)">InFRASTRUCTURE</span>
    </h1>

    <div class="flex flex-col items-center mt-8 gap-4 max-w-xl">
      <p class="text-[#64748B] font-inter text-lg md:text-xl text-center leading-relaxed">
        A new era of distributed computing. Secure, scalable, and fully sovereign networks for the next generation.
      </p>
      
      <div class="flex items-center gap-2 text-[#64748B] font-mono text-xs opacity-60">
        <span>&gt; Uptime: 99.999%</span>
        <span>|</span>
        <span>&gt; Nodes: 12,402</span>
        <span>|</span>
        <span>&gt; Latency: 2ms</span>
      </div>
    </div>

    <div class="mt-12 flex flex-col sm:flex-row items-center gap-6">
      <a href="#" class="px-10 py-4 bg-[#00D084] text-black font-mono font-bold text-sm uppercase tracking-widest rounded-sm hover:translate-y-[-2px] hover:shadow-[0_0_20px_#00D084] transition-all">
        [ RUN_SYSTEM ]
      </a>
      <a href="#" class="px-10 py-4 border border-[#1E293B] text-white font-mono text-sm uppercase tracking-widest rounded-sm hover:bg-white/5 transition-all">
        VIEW_MANIFESTO
      </a>
    </div>

  </div>

  <!-- Terminal Style Metric at the bottom -->
  <div class="absolute bottom-12 flex items-center gap-12 font-mono text-[10px] text-[#64748B] tracking-widest opacity-40 uppercase">
    <div>// ID: 0x4F2A_9B</div>
    <div>// STATUS: STABLE</div>
    <div>// REGION: GLOBAL_CORE</div>
  </div>
</section>
