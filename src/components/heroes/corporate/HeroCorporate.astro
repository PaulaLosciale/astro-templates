---
const { title = "Estrategia Global", description = "Soluciones corporativas para un mundo interconectado y digital." } = Astro.props;
---
<section class="relative h-screen flex items-center bg-gray-900 overflow-hidden">
  <div class="absolute inset-0 opacity-40">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/60 to-transparent z-10"></div>
    <div class="w-full h-full bg-primary-900/20 mix-blend-multiply"></div>
  </div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-20 w-full">
    <div class="max-w-2xl">
      <div class="w-20 h-1 bg-primary-500 mb-12"></div>
      <h1 class="text-5xl md:text-7xl font-serif font-bold text-white mb-8 leading-tight">
        {title} <br/> <span class="italic font-light">Resultados</span> Reales
      </h1>
      <p class="text-xl text-gray-300 mb-12 font-light leading-relaxed max-w-lg">
        {description}
      </p>
      <div class="flex gap-8 items-center">
        <button class="bg-primary-600 hover:bg-primary-700 text-white px-12 py-5 font-bold uppercase tracking-widest text-xs transition-all border border-primary-500">Nuestros Servicios</button>
        <button class="text-white font-bold uppercase tracking-widest text-xs border-b-2 border-white/20 pb-1 hover:border-primary-500 transition-all">Saber más</button>
      </div>
    </div>
  </div>
  
  <div class="absolute bottom-0 right-0 p-12 hidden lg:block">
      <div class="flex gap-16 text-white/40 font-bold text-xs uppercase tracking-[0.3em]">
          <span>Liderazgo</span>
          <span>Innovación</span>
          <span>Excelencia</span>
      </div>
  </div>
</section>
