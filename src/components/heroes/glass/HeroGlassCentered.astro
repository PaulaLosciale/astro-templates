---
const {
  title = "El futuro, con transparencia",
  description = "Una experiencia visual vibrante para marcas que quieren destacar.",
} = Astro.props;
---
<section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-[hsl(var(--glass-bg,300_50%_98%))]">
  <div class="absolute -top-32 -left-32 w-[480px] h-[480px] rounded-full opacity-60 blur-3xl" style="background: radial-gradient(circle, var(--glass-vivid-1, #FF00CC), transparent 70%);"></div>
  <div class="absolute top-1/3 -right-40 w-[560px] h-[560px] rounded-full opacity-60 blur-3xl" style="background: radial-gradient(circle, var(--glass-vivid-2, #3300FF), transparent 70%);"></div>
  <div class="absolute -bottom-40 left-1/3 w-[520px] h-[520px] rounded-full opacity-60 blur-3xl" style="background: radial-gradient(circle, var(--glass-vivid-3, #00CCFF), transparent 70%);"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
    <div class="backdrop-blur-2xl bg-white/20 border border-white/40 rounded-[2.5rem] px-10 py-16 shadow-2xl">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/30 border border-white/40 text-sm font-semibold text-gray-800 mb-8">✨ Nuevo</span>
      <h1 class="text-5xl md:text-7xl font-black text-gray-900 leading-tight mb-6">{title}</h1>
      <p class="text-xl text-gray-700 mb-10 max-w-xl mx-auto">{description}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#contacto" class="bg-gray-900 text-white px-10 py-4 rounded-full font-bold hover:scale-105 transition-transform">Empezar ahora</a>
        <a href="#features" class="backdrop-blur bg-white/40 border border-white/50 text-gray-900 px-10 py-4 rounded-full font-bold hover:bg-white/60 transition-colors">Saber más</a>
      </div>
    </div>
  </div>
</section>
