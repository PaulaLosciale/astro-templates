---
// HeroGlass.astro - Style 4: Glassmorfismo Hero
---

<section class="glass-hero">
  <!-- Floating badge -->
  <div class="glass-badge">
    <span class="badge-dot"></span>
    <span>Now in Beta — Join 10,000+ designers</span>
  </div>

  <!-- Headline -->
  <h1 class="glass-hero-title">
    Experience the<br/>
    <span class="gradient-text">Brilliance</span><br/>
    of Glass
  </h1>

  <!-- Subtitle -->
  <p class="glass-hero-sub">
    Transparent, blurry, and vibrant interfaces forged<br />
    from light, depth, and color. Design for the next era.
  </p>

  <!-- CTA row -->
  <div class="glass-hero-actions">
    <a href="#get-started" class="btn-glass-primary">Get Started Free</a>
    <a href="#demo" class="btn-glass-ghost">Watch Demo ▶</a>
  </div>

  <!-- Floating glass card hint -->
  <div class="glass-demo-card">
    <div class="demo-orb orb-pink"></div>
    <div class="demo-orb orb-blue"></div>
    <div class="demo-inner">
      <p class="demo-label">DESIGN SYSTEM</p>
      <p class="demo-value">GlassUI Components</p>
      <div class="demo-metrics">
        <div class="metric"><span class="metric-num">200+</span><span class="metric-label">Components</span></div>
        <div class="metric"><span class="metric-num">40+</span><span class="metric-label">Templates</span></div>
        <div class="metric"><span class="metric-num">∞</span><span class="metric-label">Possibilities</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .glass-hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10rem 2rem 6rem;
    text-align: center;
    gap: 1.5rem;
    position: relative;
  }

  .glass-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem;
    border-radius: 100px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.35);
    backdrop-filter: blur(12px);
    color: rgba(255,255,255,0.9);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #39FF14;
    box-shadow: 0 0 8px #39FF14;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .glass-hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.05;
    letter-spacing: -2px;
    margin: 0;
    text-shadow: 0 4px 32px rgba(0,0,0,0.18);
  }
  .gradient-text {
    background: linear-gradient(135deg, #FF00CC, #3300FF, #00CCFF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .glass-hero-sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(255,255,255,0.78);
    line-height: 1.7;
    max-width: 560px;
    margin: 0;
  }

  .glass-hero-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .btn-glass-primary {
    padding: 0.85rem 2.2rem;
    border-radius: 100px;
    background: rgba(255,255,255,0.22);
    border: 1px solid rgba(255,255,255,0.55);
    backdrop-filter: blur(14px);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 8px 32px rgba(51,0,255,0.18);
  }
  .btn-glass-primary:hover {
    background: rgba(255,255,255,0.35);
    transform: translateY(-2px);
  }

  .btn-glass-ghost {
    padding: 0.85rem 2rem;
    border-radius: 100px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.28);
    color: rgba(255,255,255,0.85);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-glass-ghost:hover {
    border-color: rgba(255,255,255,0.6);
    color: #fff;
  }

  /* Demo card */
  .glass-demo-card {
    position: relative;
    margin-top: 3rem;
    padding: 2rem 2.5rem;
    border-radius: 28px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.25);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 16px 64px rgba(51,0,255,0.12), inset 0 1px 0 rgba(255,255,255,0.3);
    min-width: 360px;
    overflow: hidden;
  }
  .demo-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.35;
    pointer-events: none;
  }
  .orb-pink { width: 180px; height: 180px; background: #FF00CC; top: -60px; right: -40px; }
  .orb-blue { width: 150px; height: 150px; background: #3300FF; bottom: -40px; left: -30px; }
  .demo-inner { position: relative; z-index: 1; text-align: left; }
  .demo-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.55);
    margin-bottom: 0.25rem;
  }
  .demo-value {
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 1.5rem;
  }
  .demo-metrics {
    display: flex;
    gap: 2rem;
  }
  .metric { display: flex; flex-direction: column; gap: 0.1rem; }
  .metric-num { font-size: 1.6rem; font-weight: 900; color: #fff; }
  .metric-label { font-size: 0.75rem; color: rgba(255,255,255,0.6); font-weight: 500; }
</style>
