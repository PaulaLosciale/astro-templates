<section class="py-24 bg-white dark:bg-gray-950 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-1">
       {['Innovación', 'Pasión', 'Detalle', 'Escala'].map((card, i) => (
         <div class="bg-gray-50 dark:bg-gray-900 p-12 transition-all hover:bg-primary-500 group border border-gray-100 dark:border-gray-800">
            <span class="text-xs font-black text-primary-500 group-hover:text-white dark:group-hover:text-black mb-12 block uppercase tracking-widest">Valor 0{i+1}</span>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white group-hover:text-white dark:group-hover:text-black mb-6">{card}</h3>
            <p class="text-gray-500 dark:text-gray-400 group-hover:text-white/80 dark:group-hover:text-black/70">Elevamos los estándares en cada fase del desarrollo.</p>
         </div>
       ))}
    </div>
  </div>
</section>
