<section class="py-32 bg-gray-50 dark:bg-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-24">
      <h4 class="text-primary-600 font-bold uppercase tracking-[0.3em] text-xs mb-4">Nuestra Herencia</h4>
      <h2 class="text-5xl md:text-6xl font-serif font-bold text-gray-900 dark:text-white mb-8 tracking-tight">Comprometidos con la excelencia</h2>
      <div class="w-24 h-1 bg-primary-600 mx-auto"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 text-center">
       <div>
         <span class="text-6xl font-light text-primary-200 dark:text-primary-900 mb-6 block">01</span>
         <h3 class="text-xl font-bold mb-4 dark:text-white uppercase tracking-widest">Integridad</h3>
         <p class="text-gray-500 dark:text-gray-400 font-light leading-relaxed">Operamos bajo los más estrictos estándares éticos en cada mercado global.</p>
       </div>
       <div>
         <span class="text-6xl font-light text-primary-200 dark:text-primary-900 mb-6 block">02</span>
