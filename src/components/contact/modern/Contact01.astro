---
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  contactInfo?: Array<{
    title: string;
    value: string;
    icon: string;
  }>;
}

const {
  title = "¿Tienes alguna pregunta?",
  subtitle = "Contacto",
  description = "Estamos aquí para ayudarte. Rellena el formulario y nuestro equipo te responderá en menos de 24 horas.",
  contactInfo = [
    { title: "Email", value: "loscialepaula@gmail.com", icon: "mail" },
    { title: "Teléfono", value: "+34 900 123 456", icon: "phone" },
    { title: "Ubicación", value: "Calle Innovación 42, Madrid", icon: "map-pin" }
  ]
} = Astro.props;

const getIcon = (icon: string) => {
  const icons = {
    mail: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>`,
    phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>`,
    'map-pin': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>`
  };
  return icons[icon as keyof typeof icons] || icons.mail;
};
---

<section class="py-24 bg-gray-50">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-4">{subtitle}</h2>
        <h3 class="text-4xl lg:text-5xl font-black text-gray-900 mb-8 tracking-tight">{title}</h3>
        <p class="text-xl text-gray-600 mb-12 leading-relaxed">{description}</p>
        
        <div class="space-y-8">
          {contactInfo.map((info) => (
            <div class="flex items-start gap-6 group">
              <div class="w-12 h-12 rounded-xl bg-white shadow-sm border border-gray-100 flex items-center justify-center text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><Fragment set:html={getIcon(info.icon)} /></svg>
              </div>
              <div>
                <h4 class="text-lg font-bold text-gray-900 mb-1">{info.title}</h4>
                <p class="text-gray-600">{info.value}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl border border-gray-100 custom-fade-in">
        <form action="https://formspree.io/f/xanykgpj" method="POST" class="space-y-6">
          <input type="hidden" name="_to" value="loscialepaula@gmail.com">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-bold text-gray-900 mb-2">Nombre</label>
              <input type="text" id="name" name="name" required placeholder="Tu Nombre" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" />
            </div>
            <div>
              <label for="email" class="block text-sm font-bold text-gray-900 mb-2">Email</label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" />
            </div>
          </div>
          <div>
            <label for="message" class="block text-sm font-bold text-gray-900 mb-2">Mensaje</label>
            <textarea id="message" name="message" required rows="5" placeholder="¿En qué podemos ayudarte?" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none resize-none"></textarea>
          </div>
          <button type="submit" class="w-full py-5 bg-blue-600 text-white rounded-xl font-bold text-lg hover:bg-blue-700 transition shadow-xl shadow-blue-200 hover:-translate-y-1 transform focus:ring-4 focus:ring-blue-300">
            Enviar Mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .custom-fade-in {
    animation: fadeInUp 0.8s ease-out forwards;
  }
</style>
