---
import { ContactForm } from '../../contact/modern/ContactForm';
---
<section class="py-32 bg-gray-50 dark:bg-black transition-colors duration-500">
  <div class="max-w-3xl mx-auto px-6 text-center">
     <h2 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mb-12 tracking-tighter italic">Hablemos.</h2>
     <div class="bg-white dark:bg-gray-950 p-12 rounded-[3rem] border border-gray-100 dark:border-gray-900 shadow-2xl">
        <ContactForm client:visible />
     </div>
     <p class="mt-12 text-sm text-gray-400 font-light italic">También puedes visitarnos en nuestras tiendas oficiales.</p>
  </div>
</section>
