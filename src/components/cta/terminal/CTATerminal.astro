---
---
<section class="w-full py-32 bg-[#0A0F1C] border-t border-[#1E293B] relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-6 flex flex-col items-center gap-12 relative z-10">
    
    <div class="flex flex-col items-center gap-4">
      <div class="h-12 w-[1px] bg-[#00D084] animate-bounce"></div>
      <span class="text-[#00D084] font-mono text-sm tracking-[0.4em] font-bold">
        CMD_EXECUTE
      </span>
    </div>

    <div class="flex flex-col items-center gap-6">
      <h2 class="text-white font-mono text-4xl md:text-6xl font-bold text-center uppercase tracking-tighter">
        READY TO DEPLOY<br/>
        <span class="text-[#64748B]">THE FUTURE?</span>
      </h2>
      <p class="text-[#64748B] font-inter text-center max-w-lg leading-relaxed">
        Join the decentralized revolution. Initialize your first node and start building on the most secure infrastructure on the planet.
      </p>
    </div>

    <div class="flex flex-col md:flex-row items-center gap-6 mt-4 w-full justify-center">
      <button class="w-full md:w-auto px-12 py-5 bg-[#00D084] text-black font-mono font-bold text-base uppercase tracking-widest rounded-sm hover:scale-[1.05] hover:shadow-[0_0_30px_#00D084] transition-all duration-300">
        [ INITIALIZE_NOW ]
      </a>
      <button class="w-full md:w-auto px-12 py-5 border border-[#1E293B] text-white font-mono text-base uppercase tracking-widest rounded-sm hover:bg-white/5 transition-all">
        READ_SPEC_V2
      </a>
    </div>

    <div class="mt-12 w-full max-w-2xl bg-[#1E293B]/20 rounded-sm p-4 font-mono text-[10px] text-[#64748B] border border-[#1E293B]/50 flex flex-col gap-1 overflow-hidden">
      <div class="flex items-center gap-2">
        <span class="text-[#00D084]">&gt;</span>
        <span>node_init --env production --region global</span>
      </div>
      <div class="flex items-center gap-2 opacity-50">
        <span>[INFO]</span>
        <span>Establishing p2p connection...</span>
      </div>
      <div class="flex items-center gap-2 opacity-50">
        <span>[SUCCESS]</span>
        <span>Handshake complete. 0x92AF established.</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[#00D084]">&gt;</span>
        <span class="animate-pulse">_</span>
      </div>
    </div>

  </div>

  <!-- Decorative Hex Grid -->
  <div class="absolute inset-0 opacity-[0.02] pointer-events-none flex items-center justify-center">
    <div class="text-[20vw] font-mono font-bold text-[#00D084]">0x1A4F</div>
  </div>
</section>
