---
export interface Props {
  title?: string;
  ctaText?: string;
}

const {
  title = "¿Listo para empezar?",
  ctaText = "Contactar ahora"
} = Astro.props;
---

<section class="py-24 bg-black text-white">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-4xl md:text-5xl font-black mb-12 tracking-tighter">
      {title}
    </h2>
    <a 
      href="/contact" 
      class="inline-block px-12 py-5 bg-white text-black rounded-full font-bold text-lg hover:bg-gray-200 transition-all hover:scale-105 active:scale-95"
    >
      {ctaText}
    </a>
  </div>
</section>
