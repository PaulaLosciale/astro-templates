---
export interface Props {
  logo?: string;
  siteName?: string;
  navigation?: Array<{
    label: string;
    href: string;
  }>;
  socialLinks?: Array<{
    name: string;
    href: string;
    icon: string;
  }>;
  showSocial?: boolean;
}

const {
  logo = "/logo.svg",
  siteName = "Minimal",
  navigation = [
    { label: "Work", href: "/work" },
    { label: "About", href: "/about" },
    { label: "Journal", href: "/journal" },
    { label: "Contact", href: "/contact" }
  ],
  socialLinks = [
    { name: "Twitter", href: "#", icon: "twitter" },
    { name: "Instagram", href: "#", icon: "instagram" },
    { name: "LinkedIn", href: "#", icon: "linkedin" }
  ],
  showSocial = true
} = Astro.props;
---

<header class="py-8 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Social Links (optional) -->
    {showSocial && (
      <div class="flex justify-center mb-8">
        <div class="flex items-center space-x-6">
          {socialLinks.map((social) => (
            <a 
              href={social.href}
              class="text-gray-400 hover:text-gray-900 transition-colors duration-200"
              aria-label={social.name}
            >
              {social.icon === 'twitter' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.073 4.073 0 01.8 7.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 010 16.407a11.616 11.616 0 006.29 1.84"></path>
                </svg>
              )}
              {social.icon === 'instagram' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 0C7.284 0 6.944.012 5.877.06 2.246.227.227 2.242.061 5.877.012 6.944 0 7.284 0 10s.012 3.056.06 4.123c.167 3.632 2.182 5.65 5.817 5.817C6.944 19.988 7.284 20 10 20s3.056-.012 4.123-.06c3.629-.167 5.652-2.182 5.816-5.817.05-1.067.061-1.407.061-4.123s-.012-3.056-.06-4.123C19.773 2.242 17.758.228 14.123.061 13.056.012 12.716 0 10 0zm0 1.802c2.67 0 2.987.01 4.042.059 2.71.123 3.975 1.409 4.099 4.099.048 1.054.057 1.37.057 4.04 0 2.672-.009 2.988-.057 4.042-.124 2.687-1.387 3.975-4.1 4.099-1.054.048-1.37.058-4.041.058-2.67 0-2.987-.01-4.04-.058-2.717-.124-3.977-1.416-4.1-4.1-.048-1.054-.058-1.37-.058-4.041 0-2.67.01-2.986.058-4.04.124-2.69 1.387-3.977 4.1-4.1 1.054-.048 1.37-.058 4.04-.058zM10 4.865a5.135 5.135 0 100 10.27 5.135 5.135 0 000-10.27zm0 8.468a3.333 3.333 0 110-6.666 3.333 3.333 0 010 6.666zm5.338-9.87a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z" clip-rule="evenodd"></path>
                </svg>
              )}
              {social.icon === 'linkedin' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
    )}
    
    <!-- Main Header Content -->
    <div class="flex flex-col items-center space-y-8">
      
      <!-- Logo and Site Name -->
      <div class="flex flex-col items-center space-y-4">
        <a href="/" class="group">
          <div class="w-16 h-16 bg-black rounded-full flex items-center justify-center group-hover:bg-gray-800 transition-colors duration-200">
            <span class="text-white font-bold text-xl">
              {siteName.charAt(0)}
            </span>
          </div>
        </a>
        <a href="/" class="group">
          <h1 class="text-2xl font-light text-gray-900 tracking-wide group-hover:text-gray-600 transition-colors duration-200">
            {siteName}
          </h1>
        </a>
      </div>

      <!-- Navigation -->
      <nav class="hidden md:block">
        <ul class="flex items-center space-x-12">
          {navigation.map((item) => (
            <li>
              <a 
                href={item.href}
                class="relative text-gray-600 hover:text-black font-light tracking-wide transition-colors duration-200 group"
              >
                {item.label}
                <span class="absolute bottom-0 left-1/2 w-0 h-px bg-black transition-all duration-300 group-hover:w-full group-hover:left-0"></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile Navigation Button -->
      <button 
        class="md:hidden flex flex-col items-center space-y-1 group"
        id="minimal-menu-button"
        aria-label="Toggle menu"
      >
        <span class="w-6 h-px bg-gray-600 transition-all duration-200 group-hover:bg-black"></span>
        <span class="w-4 h-px bg-gray-600 transition-all duration-200 group-hover:bg-black group-hover:w-6"></span>
        <span class="w-6 h-px bg-gray-600 transition-all duration-200 group-hover:bg-black"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden mt-8 border-t border-gray-100 pt-8" id="minimal-mobile-menu">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-center">
        <ul class="space-y-6">
          {navigation.map((item) => (
            <li>
              <a 
                href={item.href}
                class="block text-lg text-gray-600 hover:text-black font-light tracking-wide transition-colors duration-200"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      
      <!-- Mobile Social Links -->
      {showSocial && (
        <div class="flex justify-center mt-8 pt-6 border-t border-gray-100">
          <div class="flex items-center space-x-6">
            {socialLinks.map((social) => (
              <a 
                href={social.href}
                class="text-gray-400 hover:text-gray-900 transition-colors duration-200"
                aria-label={social.name}
              >
                {social.icon === 'twitter' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.073 4.073 0 01.8 7.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 010 16.407a11.616 11.616 0 006.29 1.84"></path>
                  </svg>
                )}
                {social.icon === 'instagram' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 0C7.284 0 6.944.012 5.877.06 2.246.227.227 2.242.061 5.877.012 6.944 0 7.284 0 10s.012 3.056.06 4.123c.167 3.632 2.182 5.65 5.817 5.817C6.944 19.988 7.284 20 10 20s3.056-.012 4.123-.06c3.629-.167 5.652-2.182 5.816-5.817.05-1.067.061-1.407.061-4.123s-.012-3.056-.06-4.123C19.773 2.242 17.758.228 14.123.061 13.056.012 12.716 0 10 0zm0 1.802c2.67 0 2.987.01 4.042.059 2.71.123 3.975 1.409 4.099 4.099.048 1.054.057 1.37.057 4.04 0 2.672-.009 2.988-.057 4.042-.124 2.687-1.387 3.975-4.1 4.099-1.054.048-1.37.058-4.041.058-2.67 0-2.987-.01-4.04-.058-2.717-.124-3.977-1.416-4.1-4.1-.048-1.054-.058-1.37-.058-4.041 0-2.67.01-2.986.058-4.04.124-2.69 1.387-3.977 4.1-4.1 1.054-.048 1.37-.058 4.04-.058zM10 4.865a5.135 5.135 0 100 10.27 5.135 5.135 0 000-10.27zm0 8.468a3.333 3.333 0 110-6.666 3.333 3.333 0 010 6.666zm5.338-9.87a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z" clip-rule="evenodd"></path>
                  </svg>
                )}
                {social.icon === 'linkedin' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('minimal-menu-button');
    const mobileMenu = document.getElementById('minimal-mobile-menu');
    
    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>