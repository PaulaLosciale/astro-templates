---
export interface Props {
  logo?: string;
  siteName?: string;
  navigation?: Array<{
    label: string;
    href: string;
    hasDropdown?: boolean;
    megaMenu?: {
      sections: Array<{
        title: string;
        links: Array<{ label: string; href: string; description?: string }>;
      }>;
    };
  }>;
  showCTA?: boolean;
  ctaText?: string;
  ctaHref?: string;
}

const {
  logo = "/logo.svg",
  siteName = "Enterprise",
  navigation = [
    { label: "Home", href: "/" },
    {
      label: "Solutions",
      href: "/solutions",
      hasDropdown: true,
      megaMenu: {
        sections: [
          {
            title: "Products",
            links: [
              { label: "Analytics Platform", href: "/analytics", description: "Advanced data insights" },
              { label: "Marketing Suite", href: "/marketing", description: "Complete marketing tools" },
              { label: "CRM System", href: "/crm", description: "Customer relationship management" }
            ]
          },
          {
            title: "Industries",
            links: [
              { label: "E-commerce", href: "/ecommerce", description: "Online retail solutions" },
              { label: "Healthcare", href: "/healthcare", description: "Medical industry tools" },
              { label: "Finance", href: "/finance", description: "Financial services" }
            ]
          },
          {
            title: "Resources",
            links: [
              { label: "Documentation", href: "/docs", description: "Complete guides" },
              { label: "API Reference", href: "/api", description: "Developer resources" },
              { label: "Support Center", href: "/support", description: "Help and tutorials" }
            ]
          }
        ]
      }
    },
    { label: "Pricing", href: "/pricing" },
    { label: "About", href: "/about" },
    { label: "Contact", href: "/contact" }
  ],
  showCTA = true,
  ctaText = "Start Free Trial",
  ctaHref = "/trial"
} = Astro.props;
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-3">
          <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">E</span>
          </div>
          <span class="text-xl font-bold text-gray-900">{siteName}</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-1">
        {navigation.map((item) => (
          <div class="relative group">
            <a 
              href={item.href}
              class="flex items-center px-4 py-2 text-gray-700 hover:text-blue-600 font-medium rounded-lg hover:bg-gray-50 transition-all duration-200"
            >
              {item.label}
              {item.hasDropdown && (
                <svg class="ml-1 w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              )}
            </a>
            
            {/* Mega Menu Dropdown */}
            {item.hasDropdown && item.megaMenu && (
              <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-screen max-w-4xl mt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 ease-out">
                <div class="bg-white rounded-xl shadow-xl border border-gray-200 p-8">
                  <div class="grid grid-cols-3 gap-8">
                    {item.megaMenu.sections.map((section) => (
                      <div>
                        <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">
                          {section.title}
                        </h3>
                        <ul class="space-y-3">
                          {section.links.map((link) => (
                            <li>
                              <a 
                                href={link.href}
                                class="block p-2 rounded-lg hover:bg-gray-50 transition-colors duration-150"
                              >
                                <div class="text-sm font-medium text-gray-900 mb-1">
                                  {link.label}
                                </div>
                                {link.description && (
                                  <div class="text-xs text-gray-600">
                                    {link.description}
                                  </div>
                                )}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  
                  <!-- Mega Menu Footer -->
                  <div class="mt-8 pt-6 border-t border-gray-100">
                    <div class="flex items-center justify-between">
                      <div class="text-sm text-gray-600">
                        Need help choosing? <a href="/contact" class="text-blue-600 hover:text-blue-700">Contact our experts</a>
                      </div>
                      <a 
                        href="/demo" 
                        class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors"
                      >
                        View Demo
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Right Side Actions -->
      <div class="flex items-center space-x-4">
        
        <!-- Login Link -->
        <a 
          href="/login"
          class="hidden sm:inline-flex text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          Sign In
        </a>
        
        <!-- CTA Button */
        {showCTA && (
          <a 
            href={ctaHref}
            class="inline-flex items-center px-6 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 shadow-sm hover:shadow-md"
          >
            {ctaText}
          </a>
        )}

        <!-- Mobile Menu Button -->
        <button 
          class="lg:hidden p-2 text-gray-600 hover:text-gray-900 transition-colors"
          id="mega-mobile-button"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="lg:hidden hidden border-t border-gray-200" id="mega-mobile-menu">
    <div class="px-4 py-6 bg-gray-50">
      <div class="space-y-4">
        {navigation.map((item) => (
          <div>
            <a 
              href={item.href}
              class="flex items-center justify-between py-3 px-4 text-gray-700 hover:text-blue-600 hover:bg-white rounded-lg font-medium transition-all duration-200"
            >
              {item.label}
              {item.hasDropdown && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              )}
            </a>
            
            {/* Mobile Submenu */}
            {item.hasDropdown && item.megaMenu && (
              <div class="ml-4 mt-2 space-y-2">
                {item.megaMenu.sections.map((section) => (
                  <div class="border-l-2 border-gray-200 pl-4">
                    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
                      {section.title}
                    </div>
                    {section.links.map((link) => (
                      <a 
                        href={link.href}
                        class="block py-2 px-3 text-sm text-gray-600 hover:text-blue-600 hover:bg-white rounded transition-colors"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
        
        <!-- Mobile CTA -->
        <div class="pt-4 border-t border-gray-300">
          <a 
            href="/login"
            class="block py-3 px-4 text-gray-600 hover:text-gray-900 font-medium text-center"
          >
            Sign In
          </a>
          {showCTA && (
            <a 
              href={ctaHref}
              class="block py-3 px-4 bg-blue-600 text-white font-medium rounded-lg text-center hover:bg-blue-700 transition-colors mt-2"
            >
              {ctaText}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileButton = document.getElementById('mega-mobile-button');
    const mobileMenu = document.getElementById('mega-mobile-menu');
    
    if (mobileButton && mobileMenu) {
      mobileButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>