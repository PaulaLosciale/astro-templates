---
export interface Props {
  logo?: string;
  siteName?: string;
  navigation?: Array<{
    label: string;
    href: string;
  }>;
  showCTA?: boolean;
  ctaText?: string;
  ctaHref?: string;
  showSearch?: boolean;
}

const {
  logo = "/logo.svg",
  siteName = "Brand",
  navigation = [
    { label: "Home", href: "/" },
    { label: "About", href: "/about" },
    { label: "Services", href: "/services" },
    { label: "Portfolio", href: "/portfolio" },
    { label: "Contact", href: "/contact" }
  ],
  showCTA = true,
  ctaText = "Get Started",
  ctaHref = "/get-started",
  showSearch = true
} = Astro.props;
---

<header class="fixed top-0 w-full z-50 transition-all duration-300" id="glassmorphism-header">
  <nav class="backdrop-blur-md bg-white/10 border-b border-white/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        
        <!-- Logo -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center">
            <img src={logo} alt={siteName} class="w-6 h-6 text-white" />
          </div>
          <span class="text-xl font-bold text-gray-900">{siteName}</span>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center space-x-8">
          {navigation.map((item) => (
            <a 
              href={item.href}
              class="relative text-gray-700 hover:text-blue-600 font-medium transition-all duration-200 group"
            >
              {item.label}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all duration-300 group-hover:w-full"></span>
            </a>
          ))}
        </div>

        <!-- Right Side Actions -->
        <div class="flex items-center space-x-4">
          
          {/* Search Button */}
          {showSearch && (
            <button 
              class="p-2 text-gray-600 hover:text-blue-600 hover:bg-white/20 rounded-lg transition-all duration-200"
              aria-label="Search"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </button>
          )}

          {/* CTA Button */}
          {showCTA && (
            <a 
              href={ctaHref}
              class="hidden sm:inline-flex items-center px-6 py-2.5 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-medium rounded-full hover:shadow-lg hover:scale-105 transition-all duration-200"
            >
              {ctaText}
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          )}

          {/* Mobile Menu Button */}
          <button 
            class="lg:hidden p-2 text-gray-600 hover:text-blue-600 hover:bg-white/20 rounded-lg transition-all duration-200"
            id="mobile-menu-button"
            aria-label="Toggle menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path class="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              <path class="close-icon hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="lg:hidden hidden" id="mobile-menu">
      <div class="px-4 pt-2 pb-6 backdrop-blur-md bg-white/95 border-t border-white/20">
        <div class="space-y-4">
          {navigation.map((item) => (
            <a 
              href={item.href}
              class="block py-3 px-4 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-lg font-medium transition-all duration-200"
            >
              {item.label}
            </a>
          ))}
          {showCTA && (
            <a 
              href={ctaHref}
              class="block py-3 px-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white text-center font-medium rounded-lg hover:shadow-lg transition-all duration-200 mt-4"
            >
              {ctaText}
            </a>
          )}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('glassmorphism-header');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.querySelector('.menu-icon');
    const closeIcon = document.querySelector('.close-icon');
    
    // Mobile menu toggle
    if (mobileMenuButton && mobileMenu && menuIcon && closeIcon) {
      mobileMenuButton.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');
        
        if (isOpen) {
          mobileMenu.classList.add('hidden');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        } else {
          mobileMenu.classList.remove('hidden');
          menuIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        }
      });
    }
    
    // Scroll effect
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    });
  });
</script>

<style>
  #glassmorphism-header {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  
  #glassmorphism-header.scrolled nav {
    @apply bg-white/80 border-gray-200/20;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
</style>