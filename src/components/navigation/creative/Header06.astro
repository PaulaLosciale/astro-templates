---
export interface Props {
  siteName?: string;
}

const { siteName = "CREATIVE" } = Astro.props;
---

<header class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-7xl">
  <div class="bg-white/70 backdrop-blur-xl border border-white/20 rounded-2xl px-6 py-4 shadow-2xl flex items-center justify-between">
    <a href="/" class="text-2xl font-black tracking-tighter text-indigo-900">
      {siteName}
    </a>
    
    <nav class="hidden md:flex items-center gap-8">
      <a href="#" class="text-sm font-bold text-indigo-900/60 hover:text-indigo-900 transition-colors">Trabajo</a>
      <a href="#" class="text-sm font-bold text-indigo-900/60 hover:text-indigo-900 transition-colors">Estudio</a>
      <a href="#" class="text-sm font-bold text-indigo-900/60 hover:text-indigo-900 transition-colors">Blog</a>
    </nav>
    
    <a 
      href="/contact" 
      class="bg-indigo-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200"
    >
      Hablemos
    </a>
  </div>
</header>
